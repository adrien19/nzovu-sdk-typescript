{
  "name": "@chronoqueue/client",
  "version": "0.1.0",
  "description": "ChronoQueue SDK Client sub-package",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "prepack": "node ../../scripts/block-release.mjs",
    "prepublishOnly": "node ../../scripts/block-release.mjs"
  },
  "keywords": [
    "chronoqueue",
    "client"
  ],
  "author": "ChronoQueue Team",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.12.4",
    "@chronoqueue/proto": "workspace:*",
    "long": "^5.2.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.19.0",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "protobufjs": "^7.2.5",
    "ts-jest": "^29.1.0"
  },
  "bugs": {
    "url": "https://github.com/adrien19/chronoqueue-typescript-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien19/chronoqueue-typescript-sdk.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/adrien19/chronoqueue-typescript-sdk/tree/main/packages/client",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "lib"
  ],
  "engines": {
    "node": ">= 18.0.0"
  },
  "private": true
}
