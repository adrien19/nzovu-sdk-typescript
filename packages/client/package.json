{
  "name": "@nzovu/client",
  "version": "0.0.1-dev.0",
  "description": "Nzovu SDK Client sub-package",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "prepack": "node scripts/block-release.mjs",
    "prepublishOnly": "node scripts/block-release.mjs"
  },
  "keywords": [
    "nzovu",
    "client"
  ],
  "author": "Nzovu Team",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@nzovu/proto": "workspace:*",
    "long": "^5.3.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.130",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "protobufjs": "^7.6.6",
    "ts-jest": "^29.4.13"
  },
  "bugs": {
    "url": "https://github.com/adrien19/nzovu-sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien19/nzovu-sdk-typescript.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/adrien19/nzovu-sdk-typescript/tree/main/packages/client",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib",
    "!**/__tests__/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.tsbuildinfo",
    "!**/*.d.ts.map",
    "README.md",
    "LICENCE",
    "scripts/block-release.mjs"
  ],
  "engines": {
    "node": ">= 18.0.0"
  },
  "private": true
}
