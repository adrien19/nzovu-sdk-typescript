{
  "name": "@nzovu/agent-worker-example",
  "version": "0.0.1-dev.0",
  "description": "Example agent worker system using Nzovu for task orchestration",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:producer": "tsx src/producer.ts",
    "start:worker": "tsx src/worker.ts",
    "dev": "tsx watch src/worker.ts",
    "prepack": "node ../../../scripts/block-release.mjs",
    "prepublishOnly": "node ../../../scripts/block-release.mjs"
  },
  "dependencies": {
    "@nzovu/client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "nzovu",
    "agent",
    "worker",
    "task-queue",
    "orchestration"
  ],
  "private": true
}
