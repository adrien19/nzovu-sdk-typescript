{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "module": "commonjs",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "moduleResolution": "node",
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
