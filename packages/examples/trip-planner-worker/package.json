{
  "name": "trip-planner-worker",
  "version": "0.0.1-dev.0",
  "description": "Nzovu-powered trip planning orchestration system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "producer": "ts-node src/producer.ts",
    "worker": "ts-node src/worker.ts",
    "dev": "npm-run-all --parallel producer worker",
    "prepack": "node ../../../scripts/block-release.mjs",
    "prepublishOnly": "node ../../../scripts/block-release.mjs"
  },
  "keywords": [
    "nzovu",
    "trip-planner",
    "orchestration",
    "worker",
    "task-queue"
  ],
  "author": "Nzovu Example",
  "license": "MIT",
  "dependencies": {
    "@nzovu/client": "workspace:*",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.0",
    "npm-run-all": "^4.1.5"
  },
  "private": true
}
