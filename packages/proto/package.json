{
  "name": "@nzovu/proto",
  "version": "0.0.1-dev.0",
  "description": "Nzovu SDK compiled protobuf definitions",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "require": "./lib/*.js",
      "import": "./lib/*.js",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib src/generated",
    "gen": "node ../../scripts/proto.mjs generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepack": "node ../../scripts/block-release.mjs",
    "prepublishOnly": "node ../../scripts/block-release.mjs"
  },
  "keywords": [
    "nzovu"
  ],
  "author": "Nzovu Team",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@grpc/grpc-js": "^1.14.5",
    "long": "^5.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "glob": "^10.5.0",
    "jest": "^29.7.0",
    "protoc": "33.1.0",
    "ts-jest": "^29.4.13",
    "ts-proto": "2.8.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "bugs": {
    "url": "https://github.com/adrien19/nzovu-sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien19/nzovu-sdk-typescript.git",
    "directory": "packages/proto"
  },
  "homepage": "https://github.com/adrien19/nzovu-sdk-typescript/tree/main/packages/proto",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "private": true
}
