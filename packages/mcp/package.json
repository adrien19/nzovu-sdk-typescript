{
  "name": "@chronoqueue/mcp-server",
  "version": "0.1.0",
  "description": "ChronoQueue MCP Server - Integrate ChronoQueue with AI assistants via Model Context Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "chronoqueue-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepack": "node ../../scripts/block-release.mjs",
    "prepublishOnly": "node ../../scripts/block-release.mjs"
  },
  "keywords": [
    "chronoqueue",
    "mcp",
    "model-context-protocol",
    "ai",
    "task-queue",
    "distributed-systems",
    "claude",
    "anthropic"
  ],
  "author": "ChronoQueue Team",
  "license": "MIT",
  "dependencies": {
    "@chronoqueue/client": "workspace:*",
    "@grpc/grpc-js": "^1.14.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/adrien19/chronoqueue-typescript-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien19/chronoqueue-typescript-sdk.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/adrien19/chronoqueue-typescript-sdk/tree/main/packages/mcp",
  "private": true
}
