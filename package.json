{
  "name": "chronoqueue-typescript-sdk",
  "type": "module",
  "private": true,
  "keywords": [
    "chronoqueue"
  ],
  "homepage": "https://github.com/adrien19/chronoqueue-typescript-sdk#readme",
  "bugs": {
    "url": "https://github.com/adrien19/chronoqueue-typescript-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien19/chronoqueue-typescript-sdk.git"
  },
  "license": "MIT",
  "author": "ChronoQueue Team",
  "directories": {
    "doc": "docs"
  },
  "files": [],
  "scripts": {
    "rebuild": "pnpm run clean && pnpm run build",
    "build": "lerna run --stream build",
    "build.watch": "pnpm run build:protos && tsc --build --watch packages/*/tsconfig.json",
    "build:protos": "node ./packages/proto/scripts/compile-proto.ts",
    "test": "lerna run --stream test",
    "test.watch": "lerna run --stream test.watch",
    "ci-stress": "node ./packages/test/lib/load/run-all-stress-ci-scenarios.js",
    "ci-nightly": "node ./packages/test/lib/load/run-all-nightly-scenarios.js",
    "wait-namespace": "node ./scripts/wait-on-temporal.mjs",
    "lint": "eslint 'packages/*/src/**/*.ts' --no-error-on-unmatched-pattern --fix && prettier --write .",
    "lint.check": "eslint 'packages/*/src/**/*.ts' --no-error-on-unmatched-pattern && prettier --end-of-line auto --check .",
    "lint.prune": "ts-prune --error -p tsconfig.prune.json --ignore \"used in module\" --skip \".d.ts\"",
    "format": "pnpm prettier --write .",
    "clean": "node ./scripts/clean.mjs",
    "docs": "cd packages/docs && pnpm run maybe-install-deps-and-build-docs",
    "prepack": "node scripts/block-release.mjs",
    "prepublishOnly": "node scripts/block-release.mjs"
  },
  "dependencies": {
    "@chronoqueue/client": "workspace:*",
    "@chronoqueue/proto": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@opentelemetry/api": "~1.7.0",
    "@opentelemetry/core": "^1.19.0",
    "@opentelemetry/sdk-node": "^0.46.0",
    "@tsconfig/node18": "^18.2.6",
    "@types/fs-extra": "^11.0.4",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.10.8",
    "@types/stack-utils": "^2.0.3",
    "@types/supports-color": "^8.1.3",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "arg": "^5.0.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "fs-extra": "^11.2.0",
    "json5": "^2.2.3",
    "lerna": "^8.2.3",
    "prettier": "^3.1.1",
    "ts-prune": "^0.10.3",
    "typescript": "^5.6.3",
    "verdaccio": "^6.0.1"
  },
  "engines": {
    "node": ">= 18.0.0",
    "pnpm": ">= 10.16.0"
  },
  "packageManager": "pnpm@10.16.0"
}
